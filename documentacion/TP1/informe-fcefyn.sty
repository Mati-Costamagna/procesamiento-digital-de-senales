\definecolor{grisclaro}{HTML}{F2F2F2}
\definecolor{grismedio}{HTML}{999999}
\definecolor{verdecodigo}{HTML}{2E7D32}
\definecolor{violetacodigo}{HTML}{6A1B9A}
\definecolor{naranjacodigo}{HTML}{B45309}  % directivas del preprocesador
\definecolor{rojoaviso}{HTML}{C62828}      % marcas \completar{}
% Colores de los bloques de los diagramas
\definecolor{bloquehw}{HTML}{DCE8F5}       % hardware / perifericos
\definecolor{bloquesw}{HTML}{FFF4D6}       % software / firmware
\definecolor{bloquemem}{HTML}{E4F2E4}      % memoria / buffers

\RequirePackage{amsmath,amssymb}
\RequirePackage{booktabs}
\RequirePackage{multirow}
\RequirePackage{array}
\RequirePackage{longtable}
\RequirePackage{float}
\RequirePackage{caption}
\RequirePackage{subcaption}
\RequirePackage{enumitem}
\RequirePackage{fancyhdr}
\RequirePackage{titlesec}
\RequirePackage{listings}
\RequirePackage{siunitx}
\RequirePackage{xfp}                  % \fpeval para la tabla de muestreo
