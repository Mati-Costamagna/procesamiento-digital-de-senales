\newcommand*{\@carrera}{}      \newcommand{\carrera}[1]{\renewcommand*{\@carrera}{#1}}
\newcommand*{\@subtitulo}{}    \newcommand{\subtitulo}[1]{\renewcommand*{\@subtitulo}{#1}}
\newcommand*{\@tema}{}         \newcommand{\tema}[1]{\renewcommand*{\@tema}{#1}}
\newcommand*{\@plataforma}{}   \newcommand{\plataforma}[1]{\renewcommand*{\@plataforma}{#1}}
\newcommand*{\@docentes}{}     \newcommand{\docentes}[1]{\renewcommand*{\@docentes}{#1}}
\newcommand*{\@fechaentrega}{\today}
\newcommand{\fechaentrega}[1]{\renewcommand*{\@fechaentrega}{#1}}
\newcommand*{\@logoizq}{}      \newcommand{\logoizquierdo}[1]{\renewcommand*{\@logoizq}{#1}}
