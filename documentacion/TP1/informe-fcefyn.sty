% 6. CAPTURAS DE PANTALLA Y CODIGO
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% \captura[alto]{archivo}{herramienta}{descripcion}{etiqueta}
% Si el archivo no existe dibuja un recuadro indicando que captura falta.
\newcommand{\captura}[5][0.42\textheight]{%
  \begin{figure}[H]
    \centering
    \IfFileExists{#2}{%
      \includegraphics[width=0.95\linewidth,height=#1,keepaspectratio]{#2}%
    }{%
      \stepcounter{pendientes}%
      \begin{tikzpicture}
        \node[draw=rojoaviso,dashed,thick,rounded corners=3pt,fill=rojoaviso!4,
              minimum width=0.9\linewidth,minimum height=3.2cm,align=center,
              font=\sffamily\small,text=rojoaviso]
          {Captura pendiente: \textbf{#3}\\[3pt]
           guardar como \texttt{\detokenize{#2}}};
      \end{tikzpicture}%
    }
    \caption{\textbf{#3.} #4}
    \label{#5}
  \end{figure}}

% --- Estilo de codigo C para Cortex-M / SDK MCUXpresso ---
\lstdefinestyle{cmcx}{
  language=C,
  basicstyle=\ttfamily\footnotesize,
  keywordstyle=\color{azulunc}\bfseries,
  keywordstyle=[2]\color{violetacodigo},
  keywordstyle=[3]\color{naranjacodigo},
  morekeywords=[2]{uint8_t,uint16_t,uint32_t,uint64_t,int8_t,int16_t,int32_t,
    int64_t,bool,q7_t,q15_t,q31_t,float32_t,lpadc_conv_result_t,
    lpadc_config_t,lpadc_conv_command_config_t,lpadc_conv_trigger_config_t,
    ctimer_config_t,ctimer_match_config_t,dac_config_t,vref_config_t,
    pll_setup_t,true,false},
  morekeywords=[3]{\#include,\#define,\#if,\#ifdef,\#ifndef,\#endif,\#else,
    defined},
  commentstyle=\color{verdecodigo}\itshape,
  stringstyle=\color{naranjacodigo},
  numbers=left, numberstyle=\tiny\color{grismedio}, numbersep=6pt,
  frame=tb, framerule=0.4pt, rulecolor=\color{grismedio},
  backgroundcolor=\color{grisclaro},
  xleftmargin=1.6em, framexleftmargin=1.4em,
  breaklines=true, breakatwhitespace=false,
  postbreak=\mbox{\textcolor{grismedio}{$\hookrightarrow$}\space},
  showstringspaces=false, tabsize=4, columns=fullflexible, keepspaces=true,
  captionpos=t, aboveskip=0.8em, belowskip=0.6em,
  literate={á}{{\'a}}1 {é}{{\'e}}1 {í}{{\'i}}1 {ó}{{\'o}}1 {ú}{{\'u}}1
           {Á}{{\'A}}1 {É}{{\'E}}1 {Í}{{\'I}}1 {Ó}{{\'O}}1 {Ú}{{\'U}}1
           {ñ}{{\~n}}1 {Ñ}{{\~N}}1 {°}{{\textdegree}}1,
}
\lstset{style=cmcx}
\renewcommand{\lstlistingname}{Código}
\renewcommand{\lstlistlistingname}{Índice de código}

% \codigo[opciones de listings]{archivo}{titulo}
\newcommand{\codigo}[3][]{%
  \IfFileExists{#2}{%
    \lstinputlisting[caption={#3},#1]{#2}%
  }{%
    \par\completar{Falta el archivo \texttt{\detokenize{#2}} (#3)}\par}}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% 7. TABLA DE VELOCIDADES DE MUESTREO Y LED RGB
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% \frecuenciatimer{Hz}: reloj de entrada del CTIMER.
% \divisordisparo{k}: cantidad de matches por disparo del ADC. Con la salida
%   del match en modo toggle el ADC se dispara en un flanco de cada dos, k=2.
\newcommand*{\@ftimer}{150000000}
\newcommand{\frecuenciatimer}[1]{\renewcommand*{\@ftimer}{#1}}
\newcommand*{\@kdisparo}{1}
\newcommand{\divisordisparo}[1]{\renewcommand*{\@kdisparo}{#1}}
\newcommand{\ftimer}{\qty{\fpeval{\@ftimer/1000000}}{\mega\hertz}}

% \led{R}{G}{B}: circulo con el color resultante (1 = segmento encendido)
\newcommand{\led}[3]{%
  \tikz[baseline=-0.6ex]{\definecolor{ledtmp}{rgb}{#1,#2,#3}%
    \fill[ledtmp,draw=black!70,line width=0.4pt] (0,0) circle (0.9ex);}}

% Entorno de la tabla. Cada \filafs agrega una fila y numera el estado.
\newcounter{estadofs}
\newenvironment{tablamuestreo}{%
  \setcounter{estadofs}{0}%
  \begin{tabular}{@{}c r r r r l@{}}
  \toprule
  \textbf{Estado} & \textbf{$f_s$ nominal} & \textbf{MR} &
  \textbf{$f_s$ real} & \textbf{Error} & \textbf{LED}\\
  \midrule}{%
  \bottomrule
  \end{tabular}}

% \filafs{fs nominal [Hz]}{valor de match MR}{nombre del color}{R}{G}{B}
%   fs real = ftimer / (k * (MR + 1))
\newcommand{\filafs}[6]{%
  \xdef\@fsreal{\fpeval{round(\@ftimer/(\@kdisparo*(#2+1)),2)}}%
  \xdef\@fserr{\fpeval{round(100*(\@ftimer/(\@kdisparo*(#2+1))-(#1))/(#1),3)}}%
  E\arabic{estadofs}\stepcounter{estadofs} &
  \qty{#1}{\hertz} & \num{#2} &
  \qty[round-mode=places,round-precision=2]{\@fsreal}{\hertz} &
  \qty[round-mode=places,round-precision=3]{\@fserr}{\percent} &
  \led{#4}{#5}{#6}~#3\\}

