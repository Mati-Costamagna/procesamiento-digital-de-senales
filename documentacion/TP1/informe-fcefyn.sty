% \autor{Apellido, Nombre}{Matricula}{correo}: se acumulan en una tabla.
% Un campo vacio se muestra como marca \completar{}.
\newcommand*{\@autores}{}
\newcommand{\@campoautor}[2]{\ifblank{#1}{\completar{#2}}{#1}}
\newcommand{\autor}[3]{%
  \g@addto@macro\@autores{#1 & \@campoautor{#2}{matrícula} &
                          \texttt{\small\@campoautor{#3}{correo}}\\}}

\newcommand{\@logo}[1]{%
  \IfFileExists{#1}{\includegraphics[height=2.6cm,width=4.2cm,keepaspectratio]{#1}}%
                   {\fbox{\parbox[c][2.2cm][c]{3cm}{\centering\scriptsize logo\\\texttt{\detokenize{#1}}}}}}

\newcommand{\caratula}{%
  \begin{titlepage}
    \thispagestyle{empty}
    \noindent
    \begin{minipage}[c]{0.3\textwidth}\raggedright \@logo{\@logoizq}\end{minipage}%
    \begin{minipage}[c]{0.4\textwidth}\centering
      \small\textsc{Universidad Nacional de Córdoba}\\[2pt]
      \footnotesize Facultad de Ciencias Exactas, Físicas y Naturales
    \end{minipage}%
    \begin{minipage}[c]{0.3\textwidth}\raggedleft \@logo{\@logoder}\end{minipage}

    \vspace{0.8cm}
    {\color{azulunc}\rule{\linewidth}{1.2pt}}
    \vspace{1.6cm}

    \begin{center}
      {\Large\color{azulunc}\@materia\par}
      \vspace{0.25cm}
      {\normalsize\@carrera\par}
      \vspace{1.6cm}
      {\Huge\bfseries\@subtitulo\par}
      \vspace{0.45cm}
      {\LARGE\@tema\par}
      \vspace{0.6cm}
      {\small\color{grismedio}\@plataforma\par}
    \end{center}

    \vfill
    \begin{center}
      \renewcommand{\arraystretch}{1.25}
      \begin{tabular}{@{}l l l@{}}
        \toprule
        \textbf{Integrante} & \textbf{Matrícula} & \textbf{Correo}\\
        \midrule
        \@autores
        \bottomrule
      \end{tabular}

      \vspace{0.9cm}
      {\small\textbf{Docentes:} \@docentes\par}
      \vspace{0.3cm}
      {\small\textbf{Fecha de entrega:} \@fechaentrega\par}
    \end{center}
    \vspace{0.4cm}
    {\color{azulunc}\rule{\linewidth}{1.2pt}}
  \end{titlepage}
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% 4. MARCAS DE CONTENIDO PENDIENTE
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% \completar{texto} marca en rojo lo que falta. Con \entregafinal activo,
% al terminar de compilar se avisa en el log cuantas marcas quedaron.
\newif\if@entregafinal \@entregafinalfalse
\newcommand{\entregafinal}{\@entregafinaltrue}
\newcounter{pendientes}
\newcommand{\completar}[1]{%
  \stepcounter{pendientes}%
  {\color{rojoaviso}\sffamily\small[#1]}}
\AtEndDocument{%
  \if@entregafinal
    \ifnum\value{pendientes}>0
      \PackageWarningNoLine{informe-fcefyn}{%
        Quedan \arabic{pendientes} marcas \string\completar\space sin resolver}%
    \fi
  \fi}

